{
  "expo": {
    "name": "Adika Marketplace",
    "slug": "adika-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "adika",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16acbd"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.adika.marketplace",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16acbd"
      },
      "permissions": ["INTERNET", "CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "adika.et",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "adika",
              "pathPrefix": "/listing"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://adika-y37t.onrender.com",
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
